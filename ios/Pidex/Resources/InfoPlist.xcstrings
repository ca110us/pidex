    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidex 使用相机拍摄工作照片，并读取用来识别拍摄对象的标签、编号和条码。"
          }
        }
      }
