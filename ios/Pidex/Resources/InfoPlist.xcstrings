    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发期间，Pidex 需要通过局域网连接团队的服务器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你口述场景描述时，Pidex 需要使用麦克风。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidex 会把你说的话转成场景描述的文字。"
