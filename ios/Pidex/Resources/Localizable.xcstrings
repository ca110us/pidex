    "Swipe a tag to remove it. Corrections are kept and the photo is found by them from now on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑可以移除标签。修改会被保留，之后搜索也按修改后的标签来找。"
          }
