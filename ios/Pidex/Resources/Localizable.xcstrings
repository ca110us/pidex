          }
        }
      }
    },
    "Workspaces": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区"
          }
        }
      }
    },
    "Wound photos at our clinic. Each patient wears a wristband with a name and a record number; we follow healing over weeks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们诊所的伤口照片。每个病人戴着写有姓名和病历号的腕带，我们要连续几周跟踪愈合情况。"
          }
        }
      }
    },
    "Wounds at a clinic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊所的伤口照片"
          }
        }
      }
    },
    "Wristbands, serial numbers, door numbers, asset tags.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腕带、序列号、门牌、资产标签。"
          }
        }
      }
    },
    "Written by you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你填写"
          }
        }
      }
    },
    "Written from its photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据照片生成"
          }
        }
      }
    },
    "Written from its photos once there are a few. Add what you know, such as a black nose, and searches find it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几张照片后会根据照片自动生成。也可以自己补充，比如“黑鼻子”，搜索时就能找到。"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "You can switch when %lld photos finish uploading.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片上传完后才能切换。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You can switch when %lld photo finishes uploading."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You can switch when %lld photos finish uploading."
                }
              }
            }
          }
        }
      }
    },
    "lenient": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽松"
          }
        }
      }
    },
    "standard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准"
          }
        }
      }
    },
    "strict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格"
          }
        }
      }
    },
    "“%@” is removed. Its subjects keep their photos, but new photos will not be filed under them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”被移除。它下面的对象保留原有照片，但新照片不会再归到这里。"
          }
        }
      }
    },
    "“%@” of %@ gets a new format rule; values that do not fit it are ignored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@的“%1$@”有了新的格式规则，不符合的值会被忽略。"
          }
        }
      }
    },
    "“%@” of %@ is no longer read or matched. Existing subjects keep the value.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再读取或匹配%2$@的“%1$@”，已有对象保留原值。"
          }
        }
      }
    },
    "“%@” of %@ is now matched as %@ instead of %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@的“%1$@”现在按“%3$@”匹配（原来是“%4$@”）。"
          }
        }
      }
    }
  },
  "version": "1.0"
}