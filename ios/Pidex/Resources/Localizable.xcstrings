        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %lld 张照片"
          }
        }
      }
    },
    "From these photos. Answers describe what the photos show; check them before relying on them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上回答来自这些照片，只描述照片里能看到的内容，使用前请核对。"
          }
        }
      }
