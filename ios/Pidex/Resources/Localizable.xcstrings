{
  "sourceLanguage": "en",
  "strings": {
    "%@ moves from “%@” to “%@”. Existing subjects keep their old parent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 从“%2$@”下移到“%3$@”下。已有对象仍保留原来的上级。"
          }
        }
      }
    },
    "%@ now needs %@ matching fields instead of %@, so more photos will ask you to confirm.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 现在需要 %2$@ 个字段吻合（原来是 %3$@ 个），所以会有更多照片需要你确认。"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ will be recognized by a label or code instead of by how it looks. Photos already filed stay where they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将改为通过标签或编码识别，不再看外观。已归档的照片保持不变。"
          }
        }
      }
    },
    "%@ will be recognized by how it looks instead of by a label. Photos already filed stay where they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将改为通过外观识别，不再需要标签。已归档的照片保持不变。"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        }
      }
    },
    "%d hidden: blurred, dark or nothing in them": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 张已隐藏：模糊、太暗或什么都没拍到"
          }
        }
      }
    },
    "%d photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 张照片"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%d photo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%d photos"
                }
              }
            }
          }
        }
      }
    },
    "%d photos · %d subjects": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 张照片 · %2$d 个对象"
          }
        }
      }
    },
    "%lld kept on this phone · Upload when done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张留在手机上 · 拍完点“上传”"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kept on this phone · Upload when done"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kept on this phone · Upload when done"
                }
              }
            }
          }
        }
      }
    },
    "%lld need you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张需要你处理"
          }
        }
      }
    },
    "%lld of %d photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$d 张照片"
          }
        }
      }
    },
    "%lld of these must match before a photo is filed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 %lld 项吻合才会归档照片"
          }
        }
      }
    },
    "%lld photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos"
                }
              }
            }
          }
        }
      }
    },
    "%lld photos are still uploading to the collection the camera shoots for. Shoot for another one when they are done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 张照片正在上传到相机当前所在的合集，传完后才能为其他合集拍照。"
          }
        }
      }
    },
    "%lld photos are still uploading to the current workspace. Switch when they are done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 张照片正在上传到当前工作区，传完后再切换。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo is still uploading to the current workspace. Switch when it is done."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos are still uploading to the current workspace. Switch when they are done."
                }
              }
            }
          }
        }
      }
    },
    "%lld photos are still uploading to this collection. Delete it once they are done, so none are left waiting on this phone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 张照片正在上传到这个合集。请等上传完成后再删除，免得照片卡在手机上。"
          }
        }
      }
    },
    "%lld photos filed in “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 张照片已归档到“%2$@”"
          }
        }
      }
    },
    "%lld photos filed in “%@”, %lld hidden": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档 %lld 张到“%@”，隐藏 %lld 张"
          }
        }
      }
    },
    "%lld photos not filed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片未归档"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo not filed"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos not filed"
                }
              }
            }
          }
        }
      }
    },
    "%lld photos not identified: choose who, or delete them": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片还没有身份：请选择是谁，或删掉"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo not identified: choose who, or delete it"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos not identified: choose who, or delete them"
                }
              }
            }
          }
        }
      }
    },
    "%lld photos not uploaded yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 张没上传"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo not uploaded yet"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos not uploaded yet"
                }
              }
            }
          }
        }
      }
    },
    "%lld photos, kept by where and when they were taken": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片，按拍摄地点和时间归好"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo, kept by where and when it was taken"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos, kept by where and when they were taken"
                }
              }
            }
          }
        }
      }
    },
    "%lld places": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个地点"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld place"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld places"
                }
              }
            }
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 张"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected"
                }
              }
            }
          }
        }
      }
    },
    "%lld taken · %lld uploading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拍 %1$lld 张 · %2$lld 张上传中"
          }
        }
      }
    },
    "%lld taken · all uploaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拍 %lld 张 · 已全部上传"
          }
        }
      }
    },
    "%lld uploading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张上传中"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. %2$@"
          }
        }
      }
    },
    "A barcode or QR code alone identifies it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅凭条码或二维码即可确定身份"
          }
        }
      }
    },
    "A name you will recognize. If one has it already, these photos go to that one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起一个你认得出的名字。如果已经有叫这个名字的，这些照片就归给它。"
          }
        }
      }
    },
    "API token (cbk_…)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 令牌（cbk_…）"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add a tag": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加标签"
          }
        }
      }
    },
    "Add another team's token to add its collection. Tokens are stored in the Keychain on this device only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加另一个团队的令牌，就会加入它的合集。令牌只保存在本机的钥匙串中。"
          }
        }
      }
    },
    "Add another team's token to shoot for it too. Tokens are stored in the Keychain on this device only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加另一个团队的令牌，就能同时为它拍照。令牌只保存在本机的钥匙串中。"
          }
        }
      }
    },
    "Add collection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加合集"
          }
        }
      }
    },
    "Add photos from the library": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册添加照片"
          }
        }
      }
    },
    "Add workspace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加工作区"
          }
        }
      }
    },
    "Added by a person": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人工添加"
          }
        }
      }
    },
    "Adding a team's token adds its collection to this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加团队的令牌，会把它的合集加到这台 iPhone 上。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Affects photos already filed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会影响已归档的照片"
          }
        }
      }
    },
    "All %lld filed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张全部归档"
          }
        }
      }
    },
    "All collections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有合集"
          }
        }
      }
    },
    "All places": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部地点"
          }
        }
      }
    },
    "Allow the microphone and speech recognition for Pidex in Settings to dictate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Pidex 使用麦克风和语音识别，才能语音输入。"
          }
        }
      }
    },
    "Almost there…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马上就好…"
          }
        }
      }
    },
    "Another collection once %lld photos are uploaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 张照片在上传，传完后才能换合集"
          }
        }
      }
    },
    "Any language. Say what you photograph, what identifies each one (a label, a tag, a number), and what you will want to find later. For example: “I look after 15 houseplants and want to track their growth and pests. They have no labels yet.”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用任何语言都可以。说说你要拍什么、靠什么认出每一个（标签、吊牌、编号），以及以后想找什么。例如：“我养了 15 盆绿植，想记录它们的生长和病虫害，目前还没有标签。”"
          }
        }
      }
    },
    "Apply changes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用修改"
          }
        }
      }
    },
    "Are these %lld %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 %1$lld 张都是%2$@吗？"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问"
          }
        }
      }
    },
    "Ask a question": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问"
          }
        }
      }
    },
    "Ask about your photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问一个关于照片的问题"
          }
        }
      }
    },
    "Ask all collections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问所有合集"
          }
        }
      }
    },
    "Ask all your collections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问你所有的合集"
          }
        }
      }
    },
    "Ask or find photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问或找照片"
          }
        }
      }
    },
    "Ask your team admin for a token. It is stored in the Keychain on this device only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请向团队管理员索取令牌。令牌只保存在本机的钥匙串中。"
          }
        }
      }
    },
    "Ask “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问“%@”"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动判断"
          }
        }
      }
    },
    "Barcodes and QR codes are read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会读取条码和二维码"
          }
        }
      }
    },
    "Barcodes no longer identify %@ by “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条码不再用“%2$@”来识别%1$@。"
          }
        }
      }
    },
    "By %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按%@区分"
          }
        }
      }
    },
    "By a label or number": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按标签或编号"
          }
        }
      }
    },
    "By a label, tag or number on each": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有标签、条码或编号"
          }
        }
      }
    },
    "By how it looks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按外观识别"
          }
        }
      }
    },
    "By how they look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠外观"
          }
        }
      }
    },
    "By how they look (no labels)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠外观（没有标记）"
          }
        }
      }
    },
    "By place and time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按地点和时间"
          }
        }
      }
    },
    "Camera access is off. Enable it in Settings › Pidex.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已关闭。请在“设置 › Pidex”中打开。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改"
          }
        }
      }
    },
    "Change scenario": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改场景"
          }
        }
      }
